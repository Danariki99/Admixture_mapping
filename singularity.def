Bootstrap: docker
From: python:3.8.20

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1

%post

    apt-get update && apt-get install -y bcftools



    apt-get update && apt-get install -y \
        build-essential \
        gcc \
        gfortran \
        libopenblas-dev \
        liblapack-dev \
        git \
        curl \
        wget \
        unzip \
        bzip2 \
        ca-certificates \
        make \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        && rm -rf /var/lib/apt/lists/*
    
    
    pip install --upgrade pip


    pip install \
        matplotlib==3.7.5 \
        numpy==1.20.3 \
        pandas==1.3.5 \
        PyYAML==5.1.2 \
        scikit-learn==1.0.1 \
        scipy==1.10.1 \
        seaborn==0.11.2 \
        sklearn-crfsuite==0.3.6 \
        tqdm==4.62.3 \
        uncertainty-calibration==0.1.4 \
        xgboost==1.1.1 \
        requests==2.32.3 \
        Pillow==9.5.0 \
        snputils==0.2.11 \
        statsmodels==0.13.5 \
        pyliftover==0.4 \
        pysam==0.22.1 \
        h5py==3.7.0 \
        polars-lts-cpu==0.20.31 \
        openpyxl==3.1.2 \

    pip install --no-deps \
        scikit-allel==1.3.1 \

    pip uninstall -y dask distributed || true

    # bedtools: required by pybedtools in the Borzoi SED step
    apt-get update && apt-get install -y bedtools

    # =====================================================================
    # BORZOI environment (SEPARATE venv — TensorFlow needs a newer numpy than
    # the 1.20 pinned in the main env). Left commented so the base container
    # still builds without the (large, GPU-oriented) Borzoi stack. Uncomment
    # and mount the Borzoi repo + saved models to run the Borzoi SED steps.
    #
    # python3 -m venv /opt/borzoi_env
    # /opt/borzoi_env/bin/pip install --upgrade pip
    # /opt/borzoi_env/bin/pip install tensorflow==2.15.* \
    #     pybedtools intervaltree pysam pyfaidx h5py pandas numpy scipy
    # # GPU CUDA libs (match TF 2.15): install the nvidia-*-cu12 packages, then
    # # export LD_LIBRARY_PATH from their lib dirs at runtime.
    # # baskerville + borzoi come from the Borzoi repo:
    # #   /opt/borzoi_env/bin/pip install -e /path/to/borzoi
    # =====================================================================

    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        dirmngr \
        wget \
        gnupg \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev

    gpg --keyserver keyserver.ubuntu.com --recv-keys B8F25A8A73EACF41
    gpg --export B8F25A8A73EACF41 | gpg --dearmor -o /usr/share/keyrings/cran-archive-keyring.gpg

    echo "deb [signed-by=/usr/share/keyrings/cran-archive-keyring.gpg] https://cloud.r-project.org/bin/linux/debian bookworm-cran40/" > /etc/apt/sources.list.d/cran.list

    apt-get update && apt-get install -y --no-install-recommends r-base


    Rscript -e 'install.packages("BiocManager", repos="https://cloud.r-project.org")'
    Rscript -e 'BiocManager::install(version = "3.21", ask = FALSE)'
    Rscript -e 'BiocManager::install("biomaRt")'
    Rscript -e 'install.packages(c("data.table", "optparse"), repos="https://cloud.r-project.org")'
    Rscript -e 'install.packages("dbplyr", repos = "https://cloud.r-project.org")'
    
    




%runscript

    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "❌ ERROR: You must provide <data_folder> and <result_folder> as arguments!"
        echo "👉 Example: singularity run singularity.sif /path/to/data /path/to/results"
        exit 1
    fi

    ./code_test.sh "$1" "$2"
